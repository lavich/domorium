{
  "name": "domorium",
  "version": "1.0.0",
  "description": "Domorium GEDCOM editing tools for the web, Visual Studio Code, and JetBrains IDEs",
  "scripts": {
    "build:libs": "npm run build -w packages/language-server && npm run build -w packages/codemirror",
    "build:vscode": "npm run build -w apps/vscode",
    "test": "vitest",
    "test:run": "vitest --run",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "check:docs": "node scripts/check-docs.mjs",
    "check:typescript": "npm run lint && npm run typecheck && npm run test:run",
    "check:jetbrains": "./apps/jetbrains/gradlew -p apps/jetbrains spotlessCheck test",
    "check": "npm run check:typescript && npm run check:docs && npm run check:jetbrains",
    "verify:codemirror-package": "node scripts/verify-codemirror-package.mjs",
    "format:staged": "lefthook run pre-commit",
    "postinstall": "npm run build:libs"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.34.0",
    "lefthook": "^2.1.10",
    "markdownlint-cli2": "^0.23.2",
    "markdownlint-rule-relative-links": "^5.1.2",
    "prettier": "^3.9.6",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "vitest": "^3.2.4"
  },
  "private": true
}
