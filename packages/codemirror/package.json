{
  "name": "@domorium/codemirror",
  "version": "1.5.1",
  "description": "CodeMirror 6 integration for GEDCOM language features",
  "keywords": [
    "gedcom",
    "genealogy",
    "codemirror",
    "editor"
  ],
  "homepage": "https://github.com/lavich/domorium#readme",
  "bugs": {
    "url": "https://github.com/lavich/domorium/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lavich/domorium.git",
    "directory": "packages/codemirror"
  },
  "license": "MIT",
  "author": {
    "name": "Andrei Lobanov",
    "email": "lobanov.andrey.lavich@gmail.com",
    "url": "https://github.com/lavich"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.0.0"
  },
  "main": "dist/index.cjs",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.cjs",
      "import": "./dist/index.esm.js"
    }
  },
  "files": [
    "dist",
    "package.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build:dependencies": "cd ../.. && npm run build -w packages/language-service",
    "build": "npm run build:dependencies && vite build && tsc --emitDeclarationOnly --declaration --outDir dist",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@domorium/language-service": "^1.5.0"
  },
  "peerDependencies": {
    "@codemirror/autocomplete": "^6.0.0",
    "@codemirror/commands": "^6.0.0",
    "@codemirror/language": "^6.0.0",
    "@codemirror/lint": "^6.0.0",
    "@codemirror/state": "^6.0.0",
    "@codemirror/view": "^6.0.0",
    "@lezer/highlight": "^1.0.0"
  }
}
