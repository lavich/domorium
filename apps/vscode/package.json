{
  "name": "gedcom",
  "license": "MIT",
  "displayName": "GEDCOM",
  "description": "GEDCOM language support by Domorium. Edit files with autocomplete, validation, navigation, and semantic highlighting",
  "publisher": "domorium",
  "version": "1.7.0",
  "author": "Andrei Lobanov",
  "repository": "https://github.com/lavich/domorium.git",
  "icon": "images/extensionIcon.png",
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "keywords": [
    "gedcom",
    "ged",
    "genealogy",
    "family tree",
    "validation",
    "syntax",
    "parser"
  ],
  "engines": {
    "vscode": "^1.100.0"
  },
  "activationEvents": [
    "onLanguage:gedcom",
    "workspaceContains:**/*.ged"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": {
      "supported": "limited",
      "description": "A link to a file beside the GEDCOM cannot be followed where the workspace is not on a file system."
    }
  },
  "contributes": {
    "languages": [
      {
        "id": "gedcom",
        "aliases": [
          "GEDCOM",
          "gedcom"
        ],
        "extensions": [
          ".ged",
          ".gedcom"
        ],
        "icon": {
          "light": "images/fileIcon.svg",
          "dark": "images/fileIcon.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "gedcom",
        "scopeName": "source.gedcom",
        "path": "./syntaxes/gedcom.tmLanguage.json"
      },
      {
        "scopeName": "markdown.gedcom.codeblock",
        "path": "./syntaxes/gedcom.markdown.json",
        "injectTo": [
          "text.html.markdown"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.gedcom": "source.gedcom"
        }
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "gedcom",
        "scopes": {
          "variable": [
            "entity.name.type",
            "variable.other.constant"
          ],
          "variable.declaration": [
            "entity.name.function",
            "entity.name.type"
          ]
        }
      }
    ],
    "configurationDefaults": {
      "[gedcom]": {
        "editor.semanticHighlighting.enabled": true
      }
    }
  },
  "vsce": {
    "dependencies": false,
    "baseImagesUrl": "https://raw.githubusercontent.com/lavich/domorium/main/apps/vscode"
  },
  "browser": "./dist/client/browserClientMain",
  "scripts": {
    "vscode:prepublish": "npm run build",
    "compile": "npm run build",
    "build:libs": "cd ../.. && npm run build -w packages/language-server && cd apps/vscode",
    "build:client": "vite build --config vite.config.client.ts",
    "build:server": "vite build --config vite.config.server.ts",
    "build": "npm run build:libs && npm run build:client && npm run build:server",
    "typecheck": "tsc --noEmit",
    "open": "code --extensionDevelopmentPath=$PWD"
  },
  "dependencies": {
    "@domorium/language-server": "*",
    "vscode-languageclient": "^10.1.0",
    "vscode-languageserver": "^10.1.0",
    "vscode-languageserver-textdocument": "^1.0.11"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/vscode": "1.100.0",
    "@vscode/test-web": "^0.0.81",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  }
}
