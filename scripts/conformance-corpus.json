{
  "source": "https://gedcom.io/testfiles/gedcom70/",
  "known": [
    {
      "issue": 95,
      "where": "the `1 warning LEXER` at line 1 of 19 files",
      "what": "A leading byte order mark is reported as an unexpected character. The specification permits it and 19 of these 22 files carry one."
    },
    {
      "issue": 92,
      "where": "date.ged (942 of its 1062 DATE lines), extensions.ged 72, 74, 76",
      "what": "A GEDCOM 7 date that names its calendar is rejected, GREGORIAN included. The last three also use extension calendars, months and epochs."
    },
    {
      "issue": 93,
      "where": "extensions.ged 59, 61, 70, 88",
      "what": "An extension enumeration value is rejected wherever an Enum is expected."
    },
    {
      "issue": 94,
      "where": "extensions.ged 67",
      "what": "A HEAD.SCHMA tag aliased to a standard URI is not resolved, so the record it declares is invisible to the pointer check."
    },
    {
      "issue": 96,
      "where": "extensions.ged 18",
      "what": "A tag declared twice in SCHMA with different URIs is reported, which the specification example itself does."
    },
    {
      "correct": true,
      "where": "extension-record.ged 10, 11, 15 and extensions.ged 62, 77, 82",
      "what": "VAL008 is right here: those tags really are undocumented, and the specification recommends against that. Not everything recorded below is a bug."
    }
  ],
